                  "pm.test('business success code', function () { pm.expect([0, 200]).to.include(json.code); });",
                  "pm.test('feed list payload', function () {",
                  "  pm.expect(json.data).to.have.property('list');",
                  "});",
                  "if (json.data && json.data.next_cursor) {",
                  "  pm.collectionVariables.set('popular_last_vid', json.data.next_cursor.last_vid || '');",
                  "  pm.collectionVariables.set('popular_last_popularity', String(json.data.next_cursor.last_popularity || ''));",
                  "}"
                ]
              }
            }
          ]
        },
