  "item": [
    {
      "name": "00-准备（可选）",
      "description": "登录并自动提取 token；如已有可用 token，可跳过本文件夹。",
      "item": [
        {
          "name": "登录并提取 token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_name\": \"{{login_username}}\",\n  \"password\": \"{{login_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/user/login",
              "host": ["{{base_url}}"],
              "path": ["user", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (json && json.code === 200 && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  pm.test('token extracted', function () { pm.expect(pm.collectionVariables.get('token')).to.be.a('string').and.not.empty; });",
                  "} else {",
                  "  console.log('登录未成功：请检查 login_username / login_password，或手动设置 token');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01-正常流程",
      "description": "覆盖最新流、热度榜、点赞榜、标签过滤、登录态聚合与关注流的多级游标翻页。",
      "item": [
        {
          "name": "游客-最新视频流-第一页",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{base_url}}/feed/list?limit={{feed_limit}}",
              "host": ["{{base_url}}"],
              "path": ["feed", "list"],
              "query": [
                { "key": "limit", "value": "{{feed_limit}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('business success code', function () { pm.expect(json.code).to.eql(200); });",
                  "pm.test('list is array', function () { pm.expect(json.data.list).to.be.an('array'); });",
                  "const list = (json.data && json.data.list) || [];",
                  "pm.collectionVariables.set('latest_page_ids', JSON.stringify(list.map((item) => item.vid)));",
                  "const cursor = json.data && json.data.next_cursor;",
                  "pm.collectionVariables.set('latest_last_vid', cursor ? (cursor.last_vid || '') : '');",
                  "pm.collectionVariables.set('latest_last_created_at', cursor ? (cursor.last_created_at || '') : '');",
                  "// 额外保存一份固定游标，供“重复游标稳定性”用例复用",
                  "pm.collectionVariables.set('stable_last_vid', cursor ? (cursor.last_vid || '') : '');",
                  "pm.collectionVariables.set('stable_last_created_at', cursor ? (cursor.last_created_at || '') : '');",
                  "if (list.length > 0) {",
                  "  const item = list[0];",
                  "  pm.test('feed item shape', function () {",
                  "    pm.expect(item).to.have.all.keys('vid','title','desc','video_url','cover_url','author_uid','author_name','avatar_url','likes_cnt','comments_cnt','popularity','is_like','is_follow','created_at');",
                  "  });",
                  "  pm.test('guest is_like/is_follow false', function () {",
                  "    pm.expect(item.is_like).to.eql(false);",
                  "    pm.expect(item.is_follow).to.eql(false);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "游客-最新视频流-第二页",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
