                { "key": "cursor.last_created_at", "value": "{{latest_last_created_at}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('business success code', function () { pm.expect(json.code).to.eql(200); });",
                  "const list = (json.data && json.data.list) || [];",
                  "const firstPage = JSON.parse(pm.collectionVariables.get('latest_page_ids') || '[]');",
                  "const current = list.map((item) => item.vid);",
                  "pm.test('no duplicate vid across pages', function () {",
                  "  const overlap = current.filter((vid) => firstPage.indexOf(vid) >= 0);",
                  "  pm.expect(overlap).to.be.an('array').that.is.empty;",
                  "});",
                  "pm.collectionVariables.set('latest_page_ids', JSON.stringify(firstPage.concat(current)));",
                  "const cursor = json.data && json.data.next_cursor;",
                  "pm.collectionVariables.set('latest_last_vid', cursor ? (cursor.last_vid || '') : '');",
                  "pm.collectionVariables.set('latest_last_created_at', cursor ? (cursor.last_created_at || '') : '');"
                ]
              }
            }
          ]
