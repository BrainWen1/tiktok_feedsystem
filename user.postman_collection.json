  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('primary_username')) {",
          "  const ts = Date.now();",
          "  pm.collectionVariables.set('primary_username', 'user_' + ts);",
          "  pm.collectionVariables.set('primary_password', 'P@ssw0rd!' + ts);",
          "  pm.collectionVariables.set('new_password', 'P@ssw0rdNew!' + ts);",
          "  pm.collectionVariables.set('updated_bio', 'bio_' + ts);",
          "  pm.collectionVariables.set('target_username', 'target_' + ts);",
          "  pm.collectionVariables.set('target_password', 'TargetP@ss!' + ts);",
          "  pm.collectionVariables.set('refresh_token', '');",
          "}",
          "const envToken = pm.environment.get('token');",
          "const colToken = pm.collectionVariables.get('token');",
          "if (envToken) {",
          "  pm.collectionVariables.set('token', envToken);",
          "} else if (colToken) {",
          "  pm.environment.set('token', colToken);",
          "}"
        ]
      }
    }
  ],
