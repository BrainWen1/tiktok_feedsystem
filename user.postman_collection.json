        {
          "name": "注册主账号",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_name\": \"{{primary_username}}\",\n  \"password\": \"{{primary_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('business success code', function () { pm.expect([0, 200]).to.include(json.code); });",
                  "pm.test('register response payload', function () {",
                  "  pm.expect(json.data).to.have.property('status');",
                  "  pm.expect(json.data.status).to.eql('Register successfully');",
                  "  pm.expect(json.data).to.have.property('user_id');",
                  "  pm.expect(json.data).to.have.property('username');",
                  "  pm.expect(json.data.username).to.eql(pm.collectionVariables.get('primary_username'));",
                  "});",
                  "pm.environment.set('my_uid', json.data.user_id);"
                ]
              }
            }
          ]
        },
