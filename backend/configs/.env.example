# 运行环境：dev/development 输出人类可读文本日志；prod/production 输出 JSON 结构化日志
# prod 下同时将 Gin 切换为 release 模式，关闭 [GIN-debug] 路由打印，避免污染 JSON 日志流
APP_ENV=dev

# 日志级别（可选）：留空时 dev 默认 debug、prod 默认 info；可显式覆盖为 debug/info/warn/error
LOG_LEVEL=

# mysql
MYSQL_DSN=root:123456@tcp(127.0.0.1:3306)/feedsystem?charset=utf8mb4&parseTime=True&loc=Local

# redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
# 仅为示例，至少为 32 字节随机字符串，生产环境请自行生成（$openssl rand -hex 32）并妥善保管
JWT_SECRET=461973b1420752ca07baad055abab988ac87497fed5cf7225ed989e82df41eb8
JWT_EXPIRE_HOUR=24

# server
HTTP_PORT=8080

# 持久化存储根目录：用户上传资产（upload/）与项目内置静态资源（static/）。
# 该目录需要备份，后续可整体迁移到 OSS/MinIO；生产环境建议挂载独立数据盘。
STORAGE_ROOT=./assets

# 运行时目录：日志、pid、一次性临时文件（tmp/）。
# 容器/机器重建时可直接清空，禁止存放任何用户持久上传资源。
RUNTIME_ROOT=./.run

# CORS：允许跨域携带凭证的来源白名单，逗号分隔；留空表示拒绝所有跨域请求
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# rabbitmq
MQ_HOST=
MQ_PORT=5672
MQ_USERNAME=admin
MQ_PASSWORD=123456
