        "/user/change_password": {
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "description": "校验旧密码后修改为新密码，并使当前 access token 失效；data 包含 status 字段",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "用户模块"
                ],
                "summary": "修改用户密码",
                "parameters": [
                    {
                        "description": "修改密码信息",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/feedsystem_internal_dto.ChangePasswordRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "修改成功",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/feedsystem_internal_utils_response.Response"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "additionalProperties": true
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "参数错误、旧密码错误或新密码不符合要求",
                        "schema": {
                            "$ref": "#/definitions/feedsystem_internal_utils_response.Response"
                        }
                    },
                    "401": {
                        "description": "未登录或登录已过期",
                        "schema": {
                            "$ref": "#/definitions/feedsystem_internal_utils_response.Response"
                        }
                    },
                    "500": {
                        "description": "服务器内部错误",
                        "schema": {
                            "$ref": "#/definitions/feedsystem_internal_utils_response.Response"
                        }
                    }
                }
            }
        },
