                    "type": "string"
                }
            }
        },
        "feedsystem_internal_dto.ProfileResponse": {
            "type": "object",
            "properties": {
                "avatar_url": {
                    "type": "string"
                },
                "bio": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "user_name": {
                    "type": "string"
                }
            }
        },
        "feedsystem_internal_dto.RefreshRequest": {
            "type": "object",
            "properties": {
                "old_access_token": {
                    "type": "string"
                },
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "feedsystem_internal_dto.RegisterRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string"
                },
                "user_name": {
                    "type": "string"
                }
            }
        },
        "feedsystem_internal_dto.UpdateProfileRequest": {
            "type": "object",
            "properties": {
                "avatar_url": {
                    "type": "string"
                },
                "bio": {
                    "type": "string"
                },
                "user_name": {
                    "description": "使用指针类型，这样可以区分字段是未传入还是传入了空值",
                    "type": "string"
                }
            }
        },
        "feedsystem_internal_utils_response.Response": {
            "type": "object",
            "properties": {
                "code": {
                    "description": "状态码",
                    "type": "integer"
                },
                "data": {
